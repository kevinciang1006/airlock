# ---------------------------------------------------------------------------
# Airlock environment variables
# Copy to `.env` (and/or `.env.local`) and fill in.
#
# Local dev: run `supabase start` and copy the printed API URL + keys here.
# Production: use your hosted Supabase project's values.
# ---------------------------------------------------------------------------

# Public — safe to expose to the browser. Used by the SSR/browser clients.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public — where the app is served (used for OAuth / magic-link redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECRET — service role key. Bypasses RLS. NEVER expose to the browser and
# NEVER use it in application code. Used ONLY by the seed script and the
# admin-only user-creation step of the isolation tests.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
